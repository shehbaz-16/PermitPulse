# Copy to .env and fill in. Never commit .env.
BUILDDATA_API_KEY=
BUILDDATA_MUNICIPALITY=markham
BUILDDATA_LOOKBACK_DAYS=120
BUILDDATA_MAX_PAGES=5
# MARKHAM_ARCGIS_TREE_URL=
# MARKHAM_ARCGIS_DEVAPP_URL=
# Optional: Stripe billing (use a TEST key first: dashboard.stripe.com/test/apikeys). Without it the app runs in demo mode.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...     (production webhook: POST /api/billing/webhook, event checkout.session.completed)
# APP_URL=https://yourdomain.ca       (base URL for Stripe success/cancel redirects; defaults to the request host)
# Optional: email the PermitPulse team when a contractor requests a done-for-you social campaign (resend.com)
# RESEND_API_KEY=
# NOTIFY_EMAIL=you@example.com
# NOTIFY_FROM=PermitPulse <onboarding@resend.dev>
# Optional: enables "AI summary" in the listing details drawer (restates the permit record only)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
